          "rawSql": "SELECT \n  stat_date AS \"Date\",\n  UPPER(realm) AS \"Theater\",\n  total_tracked_players AS \"Tracked Fleet\",\n  active_players AS \"Active Sorties\",\n  battles_fought AS \"Battles Analyzed\",\n  mean_win_rate AS \"Server Win Rate\",\n  damage_dealt AS \"Damage Total\"\nFROM daily_server_stats\nORDER BY stat_date DESC\nLIMIT 14;",
